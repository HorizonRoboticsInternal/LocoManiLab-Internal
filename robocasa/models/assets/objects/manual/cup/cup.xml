<mujoco model="telelab_cup">
  <compiler angle="radian"/>

  <default>
    <default class="visual">
      <geom group="1" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="0" rgba="0 0 0 0" density="300"
            friction="0.35 0.015 0.005" solref="0.01 1"/>
    </default>
  </default>

  <asset>
    <!-- 70 mm outer diameter, 120 mm height, 6 mm wall thickness. -->
    <mesh name="cup_mesh" file="cup_hollow.obj"/>
    <texture type="2d" name="cup_diffuse" file="cup_wood_dark.png"/>
    <material name="cup_material" texture="cup_diffuse" rgba="1 1 1 1"
              specular="0.25" shininess="0.35" reflectance="0.02"/>
  </asset>

  <worldbody>
    <body>
      <body name="object">
        <!-- Hollow cup: outer radius 35 mm, inner radius 29 mm. -->
        <geom name="cup_visual" class="visual" type="mesh"
              material="cup_material" mesh="cup_mesh"/>

        <geom name="cup_base" class="collision" type="cylinder"
              pos="0 0 0.005" size="0.035 0.005"/>
        <geom name="cup_body" class="collision" type="cylinder"
              pos="0 0 0.060" size="0.035 0.060"/>
      </body>
    </body>
  </worldbody>
</mujoco>
