<mujoco model="open_cardboard_box">
  <compiler angle="radian"/>

  <default>
    <default class="visual">
      <geom group="1" contype="0" conaffinity="0" material="cardboard"/>
    </default>
    <default class="collision">
      <geom group="0" rgba="0 0 0 0" friction="0.9 0.03 0.01"/>
    </default>
    <default class="region">
      <geom group="1" contype="0" conaffinity="0" rgba="0 1 0 0" mass="0"/>
    </default>
  </default>

  <asset>
    <material name="cardboard" rgba="0.56 0.35 0.17 1" specular="0.05" shininess="0.05"/>
  </asset>

  <worldbody>
    <body>
      <body name="object">
        <!-- Open top with four raised walls, so either rim can be grasped. -->
        <geom name="bottom_visual" class="visual" type="box" pos="0 0 0.008" size="0.11 0.13 0.008"/>
        <geom name="wall_x_neg_visual" class="visual" type="box" pos="-0.1025 0 0.078" size="0.0075 0.13 0.07"/>
        <geom name="wall_x_pos_visual" class="visual" type="box" pos="0.1025 0 0.078" size="0.0075 0.13 0.07"/>
        <geom name="wall_y_neg_visual" class="visual" type="box" pos="0 -0.1225 0.078" size="0.095 0.0075 0.07"/>
        <geom name="wall_y_pos_visual" class="visual" type="box" pos="0 0.1225 0.078" size="0.095 0.0075 0.07"/>

        <geom name="bottom_collision" class="collision" type="box" pos="0 0 0.008" size="0.11 0.13 0.008" mass="0.45"/>
        <geom name="wall_x_neg_collision" class="collision" type="box" pos="-0.1025 0 0.078" size="0.0075 0.13 0.07" mass="0.15"/>
        <geom name="wall_x_pos_collision" class="collision" type="box" pos="0.1025 0 0.078" size="0.0075 0.13 0.07" mass="0.15"/>
        <geom name="wall_y_neg_collision" class="collision" type="box" pos="0 -0.1225 0.078" size="0.095 0.0075 0.07" mass="0.125"/>
        <geom name="wall_y_pos_collision" class="collision" type="box" pos="0 0.1225 0.078" size="0.095 0.0075 0.07" mass="0.125"/>

        <geom name="reg_bbox" class="region" type="box" pos="0 0 0.074" size="0.11 0.13 0.074"/>
      </body>
    </body>
  </worldbody>
</mujoco>
