      <geom name="green_desk_beam_right_slot_y" class="green_desk_slot_visual"
            pos="0.805 0.0995 0.035" size="0.0035 0.0005 0.350"/>
      <geom name="green_desk_beam_right_slot_x" class="green_desk_slot_visual"
            pos="0.8255 0.120 0.035" size="0.0005 0.0035 0.350"/>
      <geom name="green_desk_beam_cross_slot_y" class="green_desk_slot_visual"
            pos="0.0875 0.0995 0.035" size="0.7025 0.0005 0.0035"/>
      <geom name="green_desk_beam_cross_slot_z" class="green_desk_slot_visual"
            pos="0.0875 0.120 0.0145" size="0.7025 0.0035 0.0005"/>

      <!-- Simple invisible boxes provide stable collision geometry. -->
      <geom name="green_desk_collision_top" class="green_desk_collision"
            pos="0.075 0.7805 0.032" size="0.795 0.0175 0.422"
            friction="1.5 0.08 0.02" condim="6"
            solref="0.01 1" solimp="0.95 0.99 0.001"/>
      <geom name="green_desk_collision_leg_left_back" class="green_desk_collision"
            pos="-0.630 0.380 -0.330" size="0.025 0.380 0.025"/>
      <geom name="green_desk_collision_leg_left_front" class="green_desk_collision"
            pos="-0.630 0.380 0.400" size="0.025 0.380 0.025"/>
      <geom name="green_desk_collision_leg_right_back" class="green_desk_collision"
            pos="0.805 0.380 -0.330" size="0.025 0.380 0.025"/>
      <geom name="green_desk_collision_leg_right_front" class="green_desk_collision"
            pos="0.805 0.380 0.400" size="0.025 0.380 0.025"/>
      <geom name="green_desk_collision_upper_back" class="green_desk_collision"
            pos="0.0875 0.735 -0.330" size="0.7175 0.025 0.025"/>
      <geom name="green_desk_collision_upper_front" class="green_desk_collision"
            pos="0.0875 0.735 0.400" size="0.7175 0.025 0.025"/>
      <geom name="green_desk_collision_upper_left" class="green_desk_collision"
            pos="-0.630 0.735 0.035" size="0.025 0.025 0.365"/>
      <geom name="green_desk_collision_upper_right" class="green_desk_collision"
            pos="0.805 0.735 0.035" size="0.025 0.025 0.365"/>
      <geom name="green_desk_collision_beam_left" class="green_desk_collision"
            pos="-0.630 0.120 0.035" size="0.020 0.020 0.365"/>
      <geom name="green_desk_collision_beam_right" class="green_desk_collision"
            pos="0.805 0.120 0.035" size="0.020 0.020 0.365"/>
      <geom name="green_desk_collision_beam_cross" class="green_desk_collision"
            pos="0.0875 0.120 0.035" size="0.7175 0.020 0.020"/>
    </body>
  </worldbody>
</mujoco>
