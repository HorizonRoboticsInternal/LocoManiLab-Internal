<mujoco model="green_desk">
  <compiler angle="radian"/>

  <asset>
    <material name="green_desk_top" rgba="0.015 0.31 0.28 1"
              specular="0.22" shininess="0.32"/>
    <material name="green_desk_aluminum" rgba="0.62 0.64 0.67 1"
              specular="0.85" shininess="0.78" reflectance="0.12"/>
    <material name="green_desk_slot" rgba="0.12 0.13 0.14 1"
              specular="0.20" shininess="0.20"/>
  </asset>

  <default>
    <default class="green_desk_profile_visual">
      <geom type="box" material="green_desk_aluminum" group="1"
            contype="0" conaffinity="0"/>
    </default>
    <default class="green_desk_slot_visual">
      <geom type="box" material="green_desk_slot" group="1"
            contype="0" conaffinity="0"/>
    </default>
    <default class="green_desk_collision">
      <geom type="box" friction="0.8 0.03 0.01" density="500"
            group="0" rgba="0 0 0 0"/>
    </default>
  </default>

  <worldbody>
    <!-- Local axes: X is width, Y is height, and Z is depth. The environment
         rotates local Y onto world Z. All dimensions below are full scale. -->
    <body name="green_desk" pos="0 0 0">
      <geom name="green_desk_top_visual" type="box"
            pos="0.075 0.7805 0.032" size="0.795 0.0175 0.422"
            material="green_desk_top" group="1"
            contype="0" conaffinity="0"/>

      <!-- Four straight 50 mm aluminum-profile legs. -->
      <geom name="green_desk_leg_left_back_visual"
            class="green_desk_profile_visual"
            pos="-0.630 0.380 -0.330" size="0.025 0.380 0.025"/>
      <geom name="green_desk_leg_left_front_visual"
            class="green_desk_profile_visual"
            pos="-0.630 0.380 0.400" size="0.025 0.380 0.025"/>
      <geom name="green_desk_leg_right_back_visual"
            class="green_desk_profile_visual"
            pos="0.805 0.380 -0.330" size="0.025 0.380 0.025"/>
      <geom name="green_desk_leg_right_front_visual"
            class="green_desk_profile_visual"
            pos="0.805 0.380 0.400" size="0.025 0.380 0.025"/>

      <!-- Vertical T-slot grooves: one centered groove on each profile face. -->
      <geom name="green_desk_leg_lb_slot_x0" class="green_desk_slot_visual"
            pos="-0.6555 0.380 -0.330" size="0.0005 0.365 0.004"/>
      <geom name="green_desk_leg_lb_slot_x1" class="green_desk_slot_visual"
            pos="-0.6045 0.380 -0.330" size="0.0005 0.365 0.004"/>
      <geom name="green_desk_leg_lb_slot_z0" class="green_desk_slot_visual"
            pos="-0.630 0.380 -0.3555" size="0.004 0.365 0.0005"/>
      <geom name="green_desk_leg_lb_slot_z1" class="green_desk_slot_visual"
            pos="-0.630 0.380 -0.3045" size="0.004 0.365 0.0005"/>

      <geom name="green_desk_leg_lf_slot_x0" class="green_desk_slot_visual"
            pos="-0.6555 0.380 0.400" size="0.0005 0.365 0.004"/>
      <geom name="green_desk_leg_lf_slot_x1" class="green_desk_slot_visual"
            pos="-0.6045 0.380 0.400" size="0.0005 0.365 0.004"/>
      <geom name="green_desk_leg_lf_slot_z0" class="green_desk_slot_visual"
            pos="-0.630 0.380 0.3745" size="0.004 0.365 0.0005"/>
      <geom name="green_desk_leg_lf_slot_z1" class="green_desk_slot_visual"
            pos="-0.630 0.380 0.4255" size="0.004 0.365 0.0005"/>

      <geom name="green_desk_leg_rb_slot_x0" class="green_desk_slot_visual"
            pos="0.7795 0.380 -0.330" size="0.0005 0.365 0.004"/>
      <geom name="green_desk_leg_rb_slot_x1" class="green_desk_slot_visual"
            pos="0.8305 0.380 -0.330" size="0.0005 0.365 0.004"/>
      <geom name="green_desk_leg_rb_slot_z0" class="green_desk_slot_visual"
            pos="0.805 0.380 -0.3555" size="0.004 0.365 0.0005"/>
      <geom name="green_desk_leg_rb_slot_z1" class="green_desk_slot_visual"
            pos="0.805 0.380 -0.3045" size="0.004 0.365 0.0005"/>

      <geom name="green_desk_leg_rf_slot_x0" class="green_desk_slot_visual"
            pos="0.7795 0.380 0.400" size="0.0005 0.365 0.004"/>
      <geom name="green_desk_leg_rf_slot_x1" class="green_desk_slot_visual"
            pos="0.8305 0.380 0.400" size="0.0005 0.365 0.004"/>
      <geom name="green_desk_leg_rf_slot_z0" class="green_desk_slot_visual"
            pos="0.805 0.380 0.3745" size="0.004 0.365 0.0005"/>
      <geom name="green_desk_leg_rf_slot_z1" class="green_desk_slot_visual"
            pos="0.805 0.380 0.4255" size="0.004 0.365 0.0005"/>

      <!-- Rigid rectangular frame directly below the tabletop. -->
      <geom name="green_desk_upper_back_visual"
            class="green_desk_profile_visual"
            pos="0.0875 0.735 -0.330" size="0.7175 0.025 0.025"/>
      <geom name="green_desk_upper_front_visual"
            class="green_desk_profile_visual"
            pos="0.0875 0.735 0.400" size="0.7175 0.025 0.025"/>
      <geom name="green_desk_upper_left_visual"
            class="green_desk_profile_visual"
            pos="-0.630 0.735 0.035" size="0.025 0.025 0.365"/>
      <geom name="green_desk_upper_right_visual"
            class="green_desk_profile_visual"
            pos="0.805 0.735 0.035" size="0.025 0.025 0.365"/>

      <!-- T-slot lines on the upper frame. -->
      <geom name="green_desk_upper_back_slot_y" class="green_desk_slot_visual"
            pos="0.0875 0.7095 -0.330" size="0.7025 0.0005 0.004"/>
      <geom name="green_desk_upper_back_slot_z" class="green_desk_slot_visual"
            pos="0.0875 0.735 -0.3555" size="0.7025 0.004 0.0005"/>
      <geom name="green_desk_upper_front_slot_y" class="green_desk_slot_visual"
            pos="0.0875 0.7095 0.400" size="0.7025 0.0005 0.004"/>
      <geom name="green_desk_upper_front_slot_z" class="green_desk_slot_visual"
            pos="0.0875 0.735 0.4255" size="0.7025 0.004 0.0005"/>
      <geom name="green_desk_upper_left_slot_y" class="green_desk_slot_visual"
            pos="-0.630 0.7095 0.035" size="0.004 0.0005 0.350"/>
      <geom name="green_desk_upper_left_slot_x" class="green_desk_slot_visual"
            pos="-0.6555 0.735 0.035" size="0.0005 0.004 0.350"/>
      <geom name="green_desk_upper_right_slot_y" class="green_desk_slot_visual"
            pos="0.805 0.7095 0.035" size="0.004 0.0005 0.350"/>
      <geom name="green_desk_upper_right_slot_x" class="green_desk_slot_visual"
            pos="0.8305 0.735 0.035" size="0.0005 0.004 0.350"/>

      <!-- Three clean 40 mm lower supports retain the original H structure. -->
      <geom name="green_desk_beam_left_visual"
            class="green_desk_profile_visual"
            pos="-0.630 0.120 0.035" size="0.020 0.020 0.365"/>
      <geom name="green_desk_beam_right_visual"
            class="green_desk_profile_visual"
            pos="0.805 0.120 0.035" size="0.020 0.020 0.365"/>
      <geom name="green_desk_beam_cross_visual"
            class="green_desk_profile_visual"
            pos="0.0875 0.120 0.035" size="0.7175 0.020 0.020"/>

      <geom name="green_desk_beam_left_slot_y" class="green_desk_slot_visual"
