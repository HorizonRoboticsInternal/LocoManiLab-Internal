<mujoco model="floor_arena">
  <asset>
    <texture builtin="gradient" height="256" rgb1=".9 .9 1." rgb2=".2 .3 .4" type="skybox" width="256"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.5 0.5 0.5" rgb2="0.6 0.6 0.6" width="512" height="512"/>
    <material name="floorplane" reflectance="0.01" shininess="0.0" specular="0.0" texrepeat="10 10" texture="texplane" texuniform="true"/>
    <material name="walls_mat" reflectance="0.0" shininess="0.1" specular="0.1" rgba="0.80 0.80 0.85 1"/>
  </asset>
  <worldbody>
    <!-- Floor (collidable) -->
    <geom condim="3" group="1" material="floorplane" name="floor" pos="0 0 0" size="3 3 .125" type="plane"/>

    <!-- Enclosing walls: collidable (default contype/conaffinity=1) AND visible.
         Floor is 6m x 6m (half-extent 3). Walls are 1.5m tall (half-height 0.75). -->
    <geom name="wall_front" type="box" pos="3 0 0.75"  size="0.05 3 0.75" material="walls_mat" group="1"/>
    <geom name="wall_rear"  type="box" pos="-3 0 0.75" size="0.05 3 0.75" material="walls_mat" group="1"/>
    <geom name="wall_left"  type="box" pos="0 3 0.75"  size="3 0.05 0.75" material="walls_mat" group="1"/>
    <geom name="wall_right" type="box" pos="0 -3 0.75" size="3 0.05 0.75" material="walls_mat" group="1"/>

    <light pos="1.0 1.0 1.5" dir="-0.2 -0.2 -1" specular="0.3 0.3 0.3" directional="true" castshadow="false"/>

    <!-- front view -->
    <camera mode="fixed" name="frontview" pos="1.6 0 1.45" quat="0.56 0.43 0.43 0.56"/>
    <!-- bird view -->
    <camera mode="fixed" name="birdview" pos="-0.2 0 3.0" quat="0.7071 0 0 0.7071"/>
    <!-- agent view -->
    <camera mode="fixed" name="agentview" pos="0.5 0 1.35" quat="0.653 0.271 0.271 0.653"/>
    <!-- side view -->
    <camera mode="fixed" name="sideview" pos="-0.05651774593317116 1.2761224129427358 1.4879572214102434" quat="0.009905065491771751 0.006877963156909582 0.5912228352893879 0.806418094001364" />
  </worldbody>
</mujoco>
