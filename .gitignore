# object assets
robocasa/models/assets/objects/**/*.glb
robocasa/models/assets/objects/**/*.obj
robocasa/models/assets/objects/**/*.mtl
robocasa/models/assets/objects/**/*.blend
robocasa/models/assets/objects/**/*.blend1
robocasa/models/assets/objects/**/*.mp4
