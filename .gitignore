robocasa/models/assets/objects/**/*.jpeg
robocasa/models/assets/objects/**/model.xml

# Don't track object assets by default; manual assets below are the exception.
robocasa/models/assets/objects/*

# Manual benchmark assets under objects/ are intentionally tracked.
!robocasa/models/assets/objects/manual/
!robocasa/models/assets/objects/manual/**
robocasa/models/assets/objects/manual/**/__pycache__/

# Task-private calibrated variants are tracked explicitly.
!robocasa/models/assets/objects/lightwheel/
!robocasa/models/assets/objects/lightwheel/glass_cup/
!robocasa/models/assets/objects/lightwheel/glass_cup/GlassCup014/
!robocasa/models/assets/objects/lightwheel/glass_cup/GlassCup014/model_long_grip.xml

# Ignore all fixture asset files
robocasa/models/assets/fixtures/**/*.glb
robocasa/models/assets/fixtures/**/*.obj
robocasa/models/assets/fixtures/**/*.mtl
robocasa/models/assets/fixtures/**/*.blend
robocasa/models/assets/fixtures/**/*.blend1
robocasa/models/assets/fixtures/**/*.mp4
robocasa/models/assets/fixtures/**/*.png
robocasa/models/assets/fixtures/**/*.jpeg
robocasa/models/assets/fixtures/**/model.xml
# Re-include selected directories
!robocasa/models/assets/fixtures/fixture_registry/**
!robocasa/models/assets/fixtures/accessories/**
!robocasa/models/assets/fixtures/counters/**

